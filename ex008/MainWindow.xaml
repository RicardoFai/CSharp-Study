<Window x:Class="ex008.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ex008"
        mc:Ignorable="d"
        Title="Gerador de Números" Height="462" Width="432" ResizeMode="NoResize" WindowStartupLocation="CenterScreen">
    <Grid Margin="0,0,60,16">
        <Label Content="Inicio" HorizontalAlignment="Left" Margin="13,36,0,0" VerticalAlignment="Top" FontSize="25"/>
        <Label Content="Fim" HorizontalAlignment="Left" Margin="23,116,0,0" VerticalAlignment="Top" FontSize="25"/>
        <Label x:Name="lblSorteio" Content="Label" HorizontalAlignment="Left" Margin="48,325,0,0" VerticalAlignment="Top" FontSize="25" Visibility="Hidden"/>
        <Button x:Name="btnSortear" Content="SORTEAR" HorizontalAlignment="Left" Margin="23,215,0,0" VerticalAlignment="Top" Width="286" Height="85" FontSize="25" Click="btnSortear_Click"/>
        <TextBox x:Name="txtIni" HorizontalAlignment="Left" Margin="139,40,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120" FontSize="25"/>
        <TextBox x:Name="txtFim" HorizontalAlignment="Left" Margin="139,120,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120" FontSize="25" TextChanged="TextBox_TextChanged"/>

    </Grid>
</Window>
