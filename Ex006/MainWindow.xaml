<Window x:Class="Ex006.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Ex006"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid Margin="-17,-60,-51,-16">
        <Label Content="Em que ano você nasceu?" HorizontalAlignment="Left" Margin="39,111,0,0" VerticalAlignment="Top" RenderTransformOrigin="0.666,3.408" FontSize="22" FontWeight="Bold"/>
        <TextBox x:Name="txtNasc" HorizontalAlignment="Left" Margin="334,119,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="203" FontSize="22" RenderTransformOrigin="0.27,-0.628" FontWeight="Bold"/>
        <Button Content="OK" HorizontalAlignment="Left" Margin="568,95,0,0" VerticalAlignment="Top" FontSize="22" Click="Button_Click" FontWeight="Bold" Height="83" Width="114"/>
        <StackPanel x:Name="panResultado" Margin="57,155,400,170" Visibility="Hidden">
            <Label x:Name="lblMsg1" Content="Label" FontSize="25"/>
            <Label x:Name="lblMsg2" Content="Label" FontSize="25" Width="1000"/>
        </StackPanel>

    </Grid>
</Window>
